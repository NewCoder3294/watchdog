    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.108.0",
    "tsx": "^4.23.1",
    "turbo": "^2.10.4",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.12",
      "postcss": "^8.5.10"
    }
  },
  "version": "1.0.0"
}
